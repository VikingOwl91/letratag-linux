+//
+// 'papplSystemSetDocumentPolicy()' - Opt in to bounded, file-based IPP reception.
+//
+// Call during serialized setup, before creating printers or running the system.
+// The format is copied; failures leave the existing policy unchanged.
+//
+
+bool
+papplSystemSetDocumentPolicy(
+    pappl_system_t *system,
+    const char     *format,
+    size_t         max_job_bytes)
+{
+  const char *slash;
+  char       *copy;
+  size_t     length;
+
+  if (!system || !format || !max_job_bytes ||
+      (length = strnlen(format, 256)) == 256 ||
+      strspn(format, "abcdefghijklmnopqrstuvwxyz0123456789!#$&^_.+-/") != length ||
+      !(slash = strchr(format, '/')) || slash == format || !slash[1] ||
+      strchr(slash + 1, '/'))
+    return (false);
+
+  _papplRWLockWrite(system);
+  if (system->is_running || system->printers || !(copy = strdup(format)))
+  {
+    _papplRWUnlock(system);
+    return (false);
+  }
+
+  free(system->document_format);
+  system->document_format = copy;
+  system->max_job_bytes   = max_job_bytes;
+  _papplRWUnlock(system);
+
+  return (true);
+}
+
+
