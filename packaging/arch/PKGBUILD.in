# Preparation template only. Supply a reviewed release tarball and SHA256.
pkgname=letratag-linux
pkgver=0.1.0
pkgrel=1
pkgdesc='Native LetraTag 200B driver with a local mock IPP development endpoint'
arch=('x86_64')
url='@PROJECT_URL@'
license=('MIT' 'Apache-2.0')
depends=('@PATCHED_PAPPL_PACKAGE@' 'libcups' 'dbus' 'poppler' 'qpdf' 'util-linux')
makedepends=('rust' 'cargo' 'pkgconf' 'clang')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('@SOURCE_SHA256@')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked
}

build() {
  cd "$pkgname-$pkgver"
  cargo build --frozen --release --all-features
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --frozen --workspace --all-features
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/letratag-printer "$pkgdir/usr/bin/letratag-printer"
  install -Dm644 packaging/systemd/letratag-linux.service "$pkgdir/usr/lib/systemd/system/letratag-linux.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 docs/legal/PAPPL-LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/PAPPL-LICENSE"
  install -Dm644 docs/legal/PAPPL-NOTICE.txt "$pkgdir/usr/share/licenses/$pkgname/PAPPL-NOTICE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
