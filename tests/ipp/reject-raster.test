{
  NAME "Unvalidated raster formats are rejected before processing"
  OPERATION Print-Job
  GROUP operation-attributes-tag
  ATTR charset attributes-charset utf-8
  ATTR language attributes-natural-language en
  ATTR uri printer-uri $uri
  ATTR name requesting-user-name test
  ATTR mimeMediaType document-format image/pwg-raster
  FILE $filename
  STATUS client-error-attributes-or-values-not-supported
  EXPECT document-format IN-GROUP unsupported-attributes-tag WITH-VALUE image/pwg-raster
}
