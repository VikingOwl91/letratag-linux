{
  NAME "Invalid PDF or job geometry must abort before transport"
  OPERATION Print-Job
  GROUP operation-attributes-tag
  ATTR charset attributes-charset utf-8
  ATTR language attributes-natural-language en
  ATTR uri printer-uri $uri
  ATTR name requesting-user-name test
  ATTR mimeMediaType document-format application/pdf
  GROUP job-attributes-tag
  ATTR collection media-col {
    MEMBER collection media-size {
      MEMBER integer x-dimension 1200
      MEMBER integer y-dimension $length
    }
    MEMBER integer media-top-margin 0
    MEMBER integer media-bottom-margin 0
    MEMBER integer media-left-margin 0
    MEMBER integer media-right-margin 0
  }
  ATTR keyword print-scaling none
  FILE $filename
  STATUS successful-ok
  EXPECT job-id
}
{
  NAME "Wait for deterministic rejection"
  OPERATION Get-Job-Attributes
  GROUP operation-attributes-tag
  ATTR charset attributes-charset utf-8
  ATTR language attributes-natural-language en
  ATTR uri printer-uri $uri
  ATTR integer job-id $job-id
  STATUS successful-ok
  EXPECT job-state WITH-VALUE 8 REPEAT-NO-MATCH REPEAT-LIMIT 30
}
